<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; everything visible is Compose (OpenCodeTheme). -->
    <style name="Theme.OpenCode" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="Theme.OpenCode.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenCode</item>
    </style>
</resources>
